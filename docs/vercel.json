{
  "routes": [
    { "src": "^/yobitel/?$", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "dest": "/yobitel/resume.md" },
    { "src": "^/yobitel/?$", "has": [{ "type": "header", "key": "accept", "value": ".*application/json.*" }], "dest": "/yobitel/resume.json" },
    { "src": "^/yobitel/?$", "has": [{ "type": "header", "key": "accept", "value": ".*yaml.*" }], "dest": "/yobitel/resume.yaml" },
    { "handle": "filesystem" }
  ]
}